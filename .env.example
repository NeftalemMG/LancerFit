# Base URL of the LancerFit backend. Two requirements:
#   1. Must end in /api — every backend route is mounted under that prefix.
#   2. Must be reachable FROM THE DEVICE. On a phone, localhost is the phone,
#      not your machine. Use your machine's LAN address, or run the dev
#      server with `npx expo start --tunnel`.
# The Socket.IO origin is derived by stripping /api, so this configures both.
EXPO_PUBLIC_API_URL=http://192.168.0.199:8000/api

# Whatever address you use here must also appear in the backend's
# CLIENT_ORIGINS allowlist, or requests fail CORS before reaching a route.
#
# Only EXPO_PUBLIC_-prefixed variables reach client code, and everything so
# prefixed ships in the bundle. Never put a secret in this file.